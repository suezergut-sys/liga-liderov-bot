# Панель организатора. В production обязательны оба значения.
ADMIN_PASSWORD=change-me
SESSION_SECRET=replace-with-at-least-32-random-characters

# Supabase Postgres transaction pooler для приложения на Vercel.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# Прямое подключение только для миграций и административных операций.
DIRECT_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

# Vercel Blob private store.
BLOB_READ_WRITE_TOKEN=

# Семь отдельных Telegram-ботов.
TELEGRAM_BOT_1_TOKEN=
TELEGRAM_BOT_1_WEBHOOK_SECRET=
TELEGRAM_BOT_1_ACTIVATION_TOKEN=
